   3          // 显式声明单总线引脚，用于释放总线 [cite: 1316, 1317]
   4          sbit DQ_Isolation = P3^7;
   5          
   6          static void SPI_Write(u8 dat)
   7          {
   8   1          u8 i; // [cite: 1320]
   9   1          XPT_CLK = 0; // [cite: 1321]
  10   1          for (i = 0; i < 8; i++) // [cite: 1322]
  11   1          {
  12   2              XPT_DIN = dat >> 7; // 放置最高位 [cite: 1324]
  13   2              dat <<= 1; // [cite: 1325]
  14   2              XPT_CLK = 0; // [cite: 1326]
  15   2              XPT_CLK = 1;        // 上升沿锁存 [cite: 1327]
  16   2          }
  17   1      }
  18          
  19          static u16 SPI_Read(void)
  20          {
  21   1          u16 i, dat = 0; // [cite: 1332]
  22   1          XPT_CLK = 0; // [cite: 1333]
  23   1          for (i = 0; i < 12; i++) // [cite: 1334]
  24   1          {
  25   2              dat <<= 1; // [cite: 1336]
  26   2              XPT_CLK = 1; // [cite: 1337]
  27   2              XPT_CLK = 0; // 下降沿读取 [cite: 1338]
  28   2              dat |= XPT_DOUT; // [cite: 1339]
  29   2          }
  30   1          return dat; // [cite: 1341]
  31   1      }
  32          
  33          u16 Read_AD_Data(u8 cmd)
  34          {
  35   1          u8 i; // [cite: 1345]
  36   1          u16 AD_Value; // [cite: 1346]
  37   1      
  38   1          // 隔离保护：先将单总线DQ释放（51单片机准双向口写1即释放总线） [cite: 1347]
  39   1          DQ_Isolation = 1; // [cite: 1348]
  40   1      
  41   1          XPT_CLK = 0; // [cite: 1349]
  42   1          XPT_CS  = 0; // 激活片选 [cite: 1350]
  43   1          SPI_Write(cmd); // [cite: 1351]
  44   1      
  45   1          for (i = 6; i > 0; i--); // 小幅延时等待转换 [cite: 1352]
  46   1      
  47   1          XPT_CLK = 1; // 产生清除BUSY的时钟 [cite: 1353]
  48   1          _nop_(); _nop_(); // [cite: 1354]
  49   1          XPT_CLK = 0; // [cite: 1355]
  50   1          _nop_(); _nop_(); // [cite: 1356]
  51   1      
  52   1          AD_Value = SPI_Read(); // [cite: 1357]
  53   1          XPT_CS = 1;  // 释放片选 [cite: 1358]
  54   1      
