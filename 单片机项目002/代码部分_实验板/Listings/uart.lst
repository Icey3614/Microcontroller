  92          /*******************************************************************************
  93          * 函 数 名: UART_Service
  94          * 函数功能: 串口通信服务函数
  95          * 返 回 值: 收到的数据（0xFF表示无数据）
  96          * 说    明: 收到数据后回显（加1返回），同时返回给调用者用于LCD显示
  97          *******************************************************************************/
  98          u8 UART_Service(void)
  99          {
 100   1          u8 rx_data;
 101   1          if (!uart_mode) return 0xFF;
 102   1      
 103   1          rx_data = UART_ReceiveByte();
 104   1          if (rx_data != 0xFF)
 105   1          {
 106   2              UART_SendByte(rx_data + 1);  // 回显：收到的数据+1
 107   2          }
 108   1          return rx_data;
 109   1      }


