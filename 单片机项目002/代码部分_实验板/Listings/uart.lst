   8          /*******************************************************************************
   9          * 函 数 名: UART_Init
  10          * 函数功能: 初始化串口，9600bps @11.0592MHz
  11          * 说    明: 使用T1作为波特率发生器，方式2（8位自动重载）
  12          *******************************************************************************/
  13          void UART_Init(void)
  14          {
  15   1          // 串口方式1（8位UART），T1方式2（8位自动重载）
  16   1          SCON = 0x50;                     // 方式1, REN=1允许接收
  17   1          TMOD = (TMOD & 0x0F) | 0x20;    // T1工作在方式2（8位自动重载）
  18   1          TH1 = 0xFD;                      // 9600bps @11.0592MHz
  19   1          TL1 = 0xFD;
  20   1          TR1 = 1;                         // 启动T1
  21   1          ES = 1;                          // 开串口中断
  22   1          EA = 1;                          // 开总中断（若已开则无影响）
  23   1      }
  24          
  25          /*******************************************************************************
  26          * 函 数 名: UART_SendByte
  27          * 函数功能: 发送一个字节
  28          *******************************************************************************/
  29          void UART_SendByte(u8 dat)
  30          {
  31   1          SBUF = dat;
  32   1          while (!TI);                     // 等待发送完成
  33   1          TI = 0;
  34   1      }
  35          
  36          /*******************************************************************************
  37          * 函 数 名: UART_SendString
  38          * 函数功能: 发送字符串
  39          *******************************************************************************/
  40          void UART_SendString(u8 *str)
  41          {
  42   1          while (*str != '\0')
  43   1          {
  44   2              UART_SendByte(*str++);
  45   2          }
  46   1      }
  47          
  48          /*******************************************************************************
  49          * 函 数 名: UART_ReceiveByte
  50          * 函数功能: 接收一个字节（非阻塞）
  51          * 返 回 值: 接收到的数据，无数据返回0xFF
  52          *******************************************************************************/
  53          u8 UART_ReceiveByte(void)
  54          {
C51 COMPILER V9.60.7.0   UART                                                              06/03/2026 21:01:23 PAGE 2   

  55   1          u8 dat;
  56   1          if (rx_flag)
  57   1          {
  58   2              dat = rx_buffer;
  59   2              rx_flag = 0;
  60   2              return dat;
  61   2          }
  62   1          return 0xFF;
  63   1      }
  64          
