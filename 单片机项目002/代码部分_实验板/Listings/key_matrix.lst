 108          /*******************************************************************************
 109          * 函 数 名: key_get_value
 110          * 功能描述: 读取当前生成的有效矩阵按键值（读取后自动销毁）
 111          *******************************************************************************/
 112          u8 key_get_value(void)
C51 COMPILER V9.60.7.0   KEY_MATRIX                                                        06/03/2026 21:01:22 PAGE 3   

 113          {
 114   1          u8 temp = key_value; // [cite: 884]
 115   1          if (temp != 0) // [cite: 885]
 116   1              key_value = 0;       // 经典的读清零机制 [cite: 886]
 117   1          return temp; // [cite: 887]
