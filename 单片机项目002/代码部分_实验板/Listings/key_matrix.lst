   1          #include "key_matrix.h"
   2          
   3          // 【修复核心】：弃用 C99 enum 枚举，改用纯 C89 标准宏定义状态，彻底解决 C141/C
             -129 编译错误
   4          #define KEY_IDLE      0  // 空闲态
   5          #define KEY_DEBOUNCE  1  // 按下消抖态
   6          #define KEY_PRESS     2  // 确认压下触发态
   7          #define KEY_RELEASE   3  // 等待完全松手拦截态
   8          
   9          #define KEY_DEBOUNCE_CNT 10    // 软件消抖滤波常数（10ms）[cite: 793]
  10          
  11          static u8 idata key_scan_cnt = 0; // [cite: 794]
  12          static u8 idata key_state = KEY_IDLE; // [cite: 795]
  13          static u8 idata key_value = 0;       // 对外输出的有效键值 [cite: 796]
  14          static u8 idata key_temp = 0;        // 硬件扫描中间暂存值 [cite: 797]
  15          
  16          /*******************************************************************************
  17          * 函 数 名: key_scan_hardware
  18          * 功能描述: 硬件层快速线反转扫描 4x4 矩阵键盘
  19          * 返 回 值: 按键交叉物理组合码（0x00=无按键压下）
  20          * 引脚映射: 行 P1.7~P1.4，列 P1.3~P1.0 [cite: 802]
  21          *******************************************************************************/
  22          static u8 key_scan_hardware(void)
  23          {
  24   1          u8 row, col; // [cite: 806]
  25   1      
  26   1          // 第一步：行引脚输出高电平，列引脚输出低电平，读取行状态
  27   1          P1 = 0xF0; // [cite: 808]
  28   1          col = P1 & 0xF0; // [cite: 809]
  29   1          if (col == 0xF0) return 0x00; // 没有任何键压下，迅速安全返回 [cite: 810]
  30   1      
  31   1          // 第二步：线反转，列引脚输出高电平，行引脚输出低电平，读取列状态
  32   1          P1 = 0x0F; // [cite: 812]
  33   1          row = P1 & 0x0F; // [cite: 813]
  34   1      
  35   1          return (col | row); // 组合成独一无二的十六进制位置组合特征码 [cite: 814]
  36   1      }
  37          
  38          /*******************************************************************************
  39          * 函 数 名: MatrixKey_Tick
  40          * 功能描述: 矩阵按键高灵敏度按下触发状态机（每1ms由定时器T0中断安全分发）
  41          *******************************************************************************/
  42          void MatrixKey_Tick(void)
  43          {
  44   1          u8 key_code; // [cite: 822]
  45   1      
  46   1          switch (key_state) // [cite: 823]
  47   1          {
  48   2              case KEY_IDLE: // [cite: 825]
  49   2                  key_code = key_scan_hardware(); // [cite: 826]
  50   2                  if (key_code != 0x00) // [cite: 827]
  51   2                  {
  52   3                      key_temp = key_code;    // 临时锁定特征值 [cite: 829]
  53   3                      key_scan_cnt = 0;       // 清空消抖计数器 [cite: 830]
C51 COMPILER V9.60.7.0   KEY_MATRIX                                                        06/03/2026 21:01:22 PAGE 2   

  54   3                      key_state = KEY_DEBOUNCE; // 切入消抖过滤判定 [cite: 831]
  55   3                  }
  56   2                  break;
  57   2      
  58   2              case KEY_DEBOUNCE: // [cite: 834]
  59   2                  key_scan_cnt++; // [cite: 835]
  60   2                  if (key_scan_cnt >= KEY_DEBOUNCE_CNT) // [cite: 836]
  61   2                  {
  62   3                      key_code = key_scan_hardware(); // [cite: 838]
  63   3                      if (key_code == key_temp) // [cite: 839]
  64   3                          key_state = KEY_PRESS;   // 确认是真实击键，立刻切入压下触发状态 [ci
             -te: 840]
  65   3                      else
  66   3                          key_state = KEY_IDLE;    // 属于噪声抖动，打回原形 [cite: 842]
  67   3                  }
  68   2                  break;
  69   2      
  70   2              case KEY_PRESS: // [cite: 845]
  71   2                  // 按下瞬间立即译码生成键值，无需等待松手
  72   2                  switch (key_temp) // [cite: 849]
  73   2                  {
  74   3                      case 0x77: key_value = MATRIX_S1;  break; // [cite: 851]
  75   3                      case 0x7B: key_value = MATRIX_S2;  break; // [cite: 852]
  76   3                      case 0x7D: key_value = MATRIX_S3;  break; // [cite: 853]
  77   3                      case 0x7E: key_value = MATRIX_S4;  break; // [cite: 854]
  78   3      
  79   3                      case 0xB7: key_value = MATRIX_S5;  break; // [cite: 855]
  80   3                      case 0xBB: key_value = MATRIX_S6;  break; // [cite: 856]
  81   3                      case 0xBD: key_value = MATRIX_S7;  break; // [cite: 857]
  82   3                      case 0xBE: key_value = MATRIX_S8;  break; // [cite: 858]
  83   3      
  84   3                      case 0xD7: key_value = MATRIX_S9;  break; // [cite: 859]
  85   3                      case 0xDB: key_value = MATRIX_S10; break; // [cite: 860]
  86   3                      case 0xDD: key_value = MATRIX_S11; break; // [cite: 861]
  87   3                      case 0xDE: key_value = MATRIX_S12; break; // [cite: 862]
  88   3      
  89   3                      case 0xE7: key_value = MATRIX_S13; break; // [cite: 863]
  90   3                      case 0xEB: key_value = MATRIX_S14; break; // [cite: 864]
  91   3                      case 0xED: key_value = MATRIX_S15; break; // [cite: 865]
  92   3                      case 0xEE: key_value = MATRIX_S16; break; // [cite: 866]
  93   3                      default: break; // [cite: 867]
  94   3                  }
  95   2                  key_state = KEY_RELEASE; // 键值生成完毕，无缝跳转至松手拦截态阻止连续重
             -发 [cite: 869]
  96   2                  break;
  97   2      
  98   2              case KEY_RELEASE: // [cite: 872]
  99   2                  key_code = key_scan_hardware(); // [cite: 846]
 100   2                  if (key_code == 0x00)    // 只有当用户物理上完全松开手指，总线重归空闲时
 101   2                  {
 102   3                      key_state = KEY_IDLE; // 才允许退出拦截状态，准备迎接下一次击键 [cite: 
             -873]
 103   3                  }
 104   2                  break;
 105   2          }
 106   1      }
