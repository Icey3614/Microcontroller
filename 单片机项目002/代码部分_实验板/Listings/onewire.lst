  50          /*******************************************************************************
  51          * 函 数 名: oneWire_sendBit
  52          * 函数功能: 发送一个位
  53          *******************************************************************************/
  54          static void oneWire_sendBit(u8 Bit)
C51 COMPILER V9.60.7.0   ONEWIRE                                                           06/03/2026 21:01:23 PAGE 2   

  55          {
  56   1          EA = 0;
  57   1          oneWire_DQ = 0;          // 拉低起始
  58   1          oneWire_DQ = Bit;        // 输出数据
  59   1          delay60us();             // 保持60us
  60   1          oneWire_DQ = 1;          // 释放总线
  61   1          EA = 1;
  62   1      }
  63          
  64          /*******************************************************************************
  65          * 函 数 名: oneWire_receiveBit
  66          * 函数功能: 接收一个位
  67          *******************************************************************************/
  68          static u8 oneWire_receiveBit(void)
  69          {
  70   1          u8 Bit;
  71   1          EA = 0;
  72   1          oneWire_DQ = 0;          // 拉低起始
  73   1          oneWire_DQ = 1;
  74   1          delay10us();             // DS18B20要求15us内采样
  75   1          Bit = oneWire_DQ;        // 采样数据
  76   1          delay60us();             // 等待时序结束
  77   1          EA = 1;
  78   1          return Bit;
  79   1      }
  80          
  81          /*******************************************************************************
  82          * 函 数 名: oneWire_sendByte
  83          * 函数功能: 发送一个字节（低位先发）
  84          *******************************************************************************/
  85          void oneWire_sendByte(u8 dat)
  86          {
  87   1          u8 i;
  88   1          for (i = 0; i < 8; i++)
  89   1          {
  90   2              oneWire_sendBit(dat & 0x01);
  91   2              dat >>= 1;
  92   2          }
  93   1      }
  94          
  95          /*******************************************************************************
  96          * 函 数 名: oneWire_receiveByte
  97          * 函数功能: 接收一个字节（低位先收）
  98          *******************************************************************************/
  99          u8 oneWire_receiveByte(void)
 100          {
 101   1          u8 dat = 0, i;
 102   1          for (i = 0; i < 8; i++)
 103   1          {
 104   2              dat >>= 1;
 105   2              if (oneWire_receiveBit())
 106   2                  dat |= 0x80;
 107   2          }
 108   1          return dat;
 109   1      }


