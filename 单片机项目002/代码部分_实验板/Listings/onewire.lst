   3          /*******************************************************************************
   4          * 延时函数（@11.0592MHz）
   5          *******************************************************************************/
   6          static void delay600us(void)
   7          {
   8   1          u8 i, j;
   9   1          _nop_();
  10   1          i = 2;
  11   1          j = 15;
  12   1          do {
  13   2              while (--j);
  14   2          } while (--i);
  15   1      }
  16          
  17          static void delay60us(void)
  18          {
  19   1          u8 i;
  20   1          i = 25;
  21   1          while (--i);
  22   1      }
  23          
  24          static void delay10us(void)
  25          {
  26   1          u8 i;
  27   1          i = 2;
  28   1          while (--i);
  29   1      }
