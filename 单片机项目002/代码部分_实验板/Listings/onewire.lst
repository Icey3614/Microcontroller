  31          /*******************************************************************************
  32          * 函 数 名: oneWire_init
  33          * 函数功能: 单总线初始化
  34          * 返 回 值: 0-有器件应答, 1-无应答
  35          *******************************************************************************/
  36          bit oneWire_init(void)
  37          {
  38   1          bit ack;
  39   1          EA = 0;
  40   1          oneWire_DQ = 0;          // 拉低总线，发复位脉冲
  41   1          delay600us();            // 480-960us
  42   1          oneWire_DQ = 1;          // 释放总线
  43   1          delay60us();             // 15-60us
  44   1          ack = oneWire_DQ;        // 读取应答信号
  45   1          delay600us();
  46   1          EA = 1;
  47   1          return ack;
  48   1      }
