line level    source

   1          /*******************************************************************************
   2           * 模块名称: LCD1602 液晶显示驱动模块（真实实验板全兼容及全局时序修复版）
   3           * 文件名称: lcd1602.c
   4           * 优化特性: 
   5           * 1. 重新实现全局 delay_ms() 函数，彻底根除 main.c 跑飞死机问题。
   6           * 2. 严格遵循工业标准执行 3 次 0x38 连续唤醒，彻底激活真实硬件的第二行显示�
             -��
   7           * 3. 强行拉低 RW (P2.5)，断绝蜂鸣器复用对液晶内核的电平污染。
   8           *******************************************************************************/
   9          #include "lcd1602.h"
  10          #include "intrins.h"
  11          
  12          #define LCD1602_DATAPORT P0
  13          
  14          /*******************************************************************************
  15           * 函 数 名: delay_ms
  16           * 功能描述: 【核心修复】：重新向全局释放标准的软件毫秒级延时，解决链接 L
             -1 警告
  17           *******************************************************************************/
  18          void delay_ms(u16 time)
  19          {
  20   1          u16 i, j;
  21   1          for (i = 0; i < time; i++)
  22   1              for (j = 0; j < 113; j++);
  23   1      }
  24          
  25          /*******************************************************************************
  26           * 函 数 名: LCD1602_write_cmd
  27           * 功能描述: 向液晶写入控制指令
  28           *******************************************************************************/
  29          void LCD1602_write_cmd(u8 cmd)
  30          {
  31   1          LCD1602_DATAPORT = 0xFF; // 清空总线，防止残留电平干扰
  32   1          LCD1602_RS = 0;          // 选择指令寄存器
  33   1          LCD1602_RW = 0;          // 强行拉低RW（强制切回写模式，屏蔽蜂鸣器干扰）
  34   1          _nop_();
  35   1          
  36   1          LCD1602_DATAPORT = cmd;  // 送入指令
  37   1          _nop_();
  38   1          
  39   1          LCD1602_E = 1;           // 拉高使能脚
  40   1          _nop_(); _nop_(); _nop_(); // 加宽使能脉冲，照顾真实硬件物理建立时间
  41   1          LCD1602_E = 0;           // 捕获下降沿，写入指令
  42   1          
  43   1          delay_ms(2);             // 留出 2ms 处理指令的时间
  44   1      }
  45          
  46          /*******************************************************************************
  47           * 函 数 名: LCD1602_write_data
  48           * 功能描述: 向液晶写入显示内容
  49           *******************************************************************************/
  50          void LCD1602_write_data(u8 dat)
  51          {
  52   1          LCD1602_DATAPORT = 0xFF; 
C51 COMPILER V9.60.7.0   LCD1602                                                           06/03/2026 21:01:22 PAGE 2   

  53   1          LCD1602_RS = 1;          // 选择数据寄存器
  54   1          LCD1602_RW = 0;          // 强行拉低RW，屏蔽蜂鸣器干扰
  55   1          _nop_();
  56   1          
  57   1          LCD1602_DATAPORT = dat;  // 送入数据
  58   1          _nop_();
  59   1          
  60   1          LCD1602_E = 1;
  61   1          _nop_(); _nop_(); _nop_(); // 加宽使能脉冲
  62   1          LCD1602_E = 0;           // 捕获下降沿，写入数据
  63   1          
  64   1          delay_ms(1);             // 留出 1ms 写入等待
  65   1      }
  66          
  67          /*******************************************************************************
  68           * 函 数 名: LCD1602_init
  69           * 功能描述: 工业级 LCD1602 硬件安全唤醒与初始化时序
  70           *******************************************************************************/
  71          void LCD1602_init(void)
  72          {
  73   1          LCD1602_E = 0;
  74   1          delay_ms(15);           // 1. 上电后硬件硬延迟 15ms，等待液晶自身电压稳态
  75   1          
  76   1          // 2. 连续 3 次写入 0x38 强行唤醒并锁死“两行显示模式”
  77   1          LCD1602_write_cmd(0x38);
  78   1          delay_ms(5);
  79   1          LCD1602_write_cmd(0x38);
  80   1          delay_ms(5);
  81   1          LCD1602_write_cmd(0x38);
  82   1          delay_ms(5);
  83   1          
  84   1          // 3. 此时功能设定正式生效，配置常规显示参数
  85   1          LCD1602_write_cmd(0x38); // 开启双行显示，5x7点阵
  86   1          LCD1602_write_cmd(0x0C); // 开启无光标显示
  87   1          LCD1602_write_cmd(0x06); // 文字输入后光标自动右移
  88   1          LCD1602_write_cmd(0x01); // 强清屏
  89   1          delay_ms(10);            // 清屏后必须给予长延时
  90   1      }
  91          
  92          /*******************************************************************************
  93           * 函 数 名: LCD1602_display
  94           * 功能描述: 动态坐标计算显示英文字串
  95           *******************************************************************************/
  96          void LCD1602_display(u8 row, u8 col, u8 *str)
  97          {
  98   1          u8 addr;
  99   1          if (row == 1)
 100   1              addr = 0x80 + (col - 1); // 第一行基地址 0x80
 101   1          else
 102   1              addr = 0xC0 + (col - 1); // 第二行基地址 0xC0
 103   1      
 104   1          LCD1602_write_cmd(addr);     // 寻址位置
 105   1      
 106   1          while (*str != '\0')
 107   1          {
 108   2              LCD1602_write_data(*str);
 109   2              str++;
 110   2          }
 111   1      }
 112          
 113          /*******************************************************************************
 114           * 函 数 名: LCD1602_display_char
C51 COMPILER V9.60.7.0   LCD1602                                                           06/03/2026 21:01:22 PAGE 3   

 115           * 功能描述: 在指定行列位置精准写入单个可见字符
 116           *******************************************************************************/
 117          void LCD1602_display_char(u8 row, u8 col, u8 chr)
 118          {
 119   1          u8 addr;
 120   1          if (row == 1)
 121   1              addr = 0x80 + (col - 1);
 122   1          else
 123   1              addr = 0xC0 + (col - 1);
 124   1      
 125   1          LCD1602_write_cmd(addr);
 126   1          LCD1602_write_data(chr);
 127   1      }
 128          
 129          /*******************************************************************************
 130           * 函 数 名: LCD1602_clear
 131           * 功能描述: 全屏一键清除刷新
 132           *******************************************************************************/
 133          void LCD1602_clear(void)
 134          {
 135   1          LCD1602_write_cmd(0x01);
 136   1          delay_ms(5); // 给足液晶芯片硬件擦除时间
 137   1      }


