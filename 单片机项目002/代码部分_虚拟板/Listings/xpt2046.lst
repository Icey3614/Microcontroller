   1          #include "xpt2046.h"
   2          
   3          // 显式声明单总线引脚，用于释放总线互斥
   4          sbit DQ_Isolation = P3^7;
   5          
   6          // 重新映射引脚名称，方便理解
   7          sbit ADC_CS  = P3^5;
   8          sbit ADC_CLK = P3^6;
   9          sbit ADC_DIO = P3^7; // DI和DO复用同一根线
  10          
  11          /*******************************************************************************
  12          * 函 数 名: Read_AD_Data
  13          * 函数功能: 针对 Proteus 普及版 ADC0832 设计的标准 SPI 8位光敏读取驱动
  14          * 返 回 值: 8位AD转换结果 (0~255)
  15          *******************************************************************************/
  16          u16 Read_AD_Data(u8 cmd)
  17          {
  18   1          u8 i;
  19   1          u8 dat_odd = 0;
  20   1          u8 dat_even = 0;
  21   1          
  22   1          // 传递的 cmd 参数在这里用作通道选择占位符，保持 main.c 兼容不报错
  23   1          (void)cmd; 
*** WARNING C275 IN LINE 23 OF xpt2046.c: expression with possibly no effect
  24   1      
  25   1          // 1. 互斥总线安全隔离保护：释放单总线 DQ（51单片机准双向口写1即释放总线
             -）
  26   1          DQ_Isolation = 1;
  27   1      
  28   1          ADC_CLK = 0;
  29   1          ADC_DIO = 1;
  30   1          ADC_CS  = 0; // 激活片选，启动芯片
  31   1      
  32   1          // 2. 按照 ADC0832 的工业时序发送起始与通道配置选择指令
  33   1          // 第1个时钟脉冲：起始位 (Start Bit = 1)
  34   1          ADC_CLK = 1; _nop_(); ADC_CLK = 0;
  35   1      
  36   1          // 第2个时钟脉冲：选择单端输入模式 (SGL = 1)
  37   1          ADC_DIO = 1;
  38   1          ADC_CLK = 1; _nop_(); ADC_CLK = 0;
  39   1      
  40   1          // 第3个时钟脉冲：选择通道 CH0 (ODD/SIGN = 0)
  41   1          ADC_DIO = 0;
  42   1          ADC_CLK = 1; 
  43   1          _nop_(); 
  44   1          ADC_CLK = 0;
  45   1      
  46   1          // 此时单片机释放 DIO 总线，准备转为输入状态接收数据
  47   1          ADC_DIO = 1; 
  48   1      
  49   1          // 3. 顺沿时钟读取由高位到低位 (MSB First) 的数据字节
  50   1          for (i = 0; i < 8; i++)
  51   1          {
  52   2              ADC_CLK = 1; _nop_(); ADC_CLK = 0; // 下降沿芯片输出数据
C51 COMPILER V9.60.7.0   XPT2046                                                           06/06/2026 16:03:53 PAGE 2   

  53   2              dat_odd <<= 1;
  54   2              if (ADC_DIO) dat_odd |= 0x01;
  55   2          }
  56   1      
  57   1          // 4. 顺沿时钟读取由低位到高位 (LSB First) 的校对数据字节
  58   1          for (i = 0; i < 8; i++)
  59   1          {
  60   2              dat_even >>= 1;
  61   2              if (ADC_DIO) dat_even |= 0x80;
  62   2              ADC_CLK = 1; _nop_(); ADC_CLK = 0;
  63   2          }
  64   1      
  65   1          ADC_CS = 1;  // 释放片选，结束转换
  66   1          DQ_Isolation = 1; // 再次显式拉高，把总线控制权完璧归赵还给 DS18B20
  67   1      
  68   1          // 校验双向读取的数据是否一致，若通过则直接返回最终亮度数值
  69   1          if (dat_odd == dat_even)
  70   1          {
  71   2              return (u16)dat_odd; 
  72   2          }
  73   1          return 0;
  74   1      }


