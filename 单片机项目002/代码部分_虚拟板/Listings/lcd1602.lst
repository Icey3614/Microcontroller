   3          /* 函 数 名: delay_ms
   4          功能描述: 软件毫秒级延时函数（@11.0592MHz）*/
   5          void delay_ms(u16 time)
   6          {
   7   1          u16 i, j;
   8   1          for (i = 0; i < time; i++)
   9   1              for (j = 0; j < 113; j++);
  10   1      }
  11          
  12          /*******************************************************************************
  13          * 函 数 名: LCD1602_write_cmd
  14          * 功能描述: 向液晶写控制指令
  15          *******************************************************************************/
  16          void LCD1602_write_cmd(u8 cmd)
  17          {
  18   1          LCD1602_RS = 0;             // 选择命令寄存器
  19   1          LCD1602_RW = 0;             // 选择写模式
  20   1          LCD1602_DATA_PIN = cmd;     // 放置指令字节
  21   1          
  22   1          // 硬件级稳态时序缓冲
  23   1          _nop_(); _nop_();
  24   1          LCD1602_E = 1;              // 产生高电平脉冲
  25   1          _nop_(); _nop_();
  26   1          LCD1602_E = 0;              // 下降沿锁存指令
  27   1          
  28   1          delay_ms(1);                // 留足1ms指令执行时间
  29   1      }
  30          
  31          /*******************************************************************************
  32          * 函 数 名: LCD1602_write_data
  33          * 功能描述: 向液晶写显示数据
  34          *******************************************************************************/
  35          void LCD1602_write_data(u8 dat)
  36          {
  37   1          LCD1602_RS = 1;             // 选择数据寄存器
  38   1          LCD1602_RW = 0;             // 选择写模式
  39   1          LCD1602_DATA_PIN = dat;     // 放置显示数据字节
  40   1          
  41   1          // 硬件级稳态时序缓冲
  42   1          _nop_(); _nop_();
  43   1          LCD1602_E = 1;              // 产生高电平脉冲
  44   1          _nop_(); _nop_();
  45   1          LCD1602_E = 0;              // 下降沿锁存数据
  46   1          
  47   1          _nop_(); _nop_();           // 给准双向口留出恢复时间
  48   1      }
  49          
  50          /*******************************************************************************
  51          * 函 数 名: LCD1602_init
  52          * 功能描述: 工业标准上电初始化序列
  53          *******************************************************************************/
  54          void LCD1602_init(void)
C51 COMPILER V9.60.7.0   LCD1602                                                           06/06/2026 16:03:52 PAGE 2   

  55          {
  56   1          delay_ms(15);               // 耐心等待液晶上电物理稳定
  57   1          LCD1602_write_cmd(0x38);    // 16*2显示，5*7点阵，8位数据接口
  58   1          LCD1602_write_cmd(0x0C);    // 显示开，光标关，闪烁关
  59   1          LCD1602_write_cmd(0x06);    // 文字写入后光标自动右移，画面不移动
  60   1          LCD1602_write_cmd(0x01);    // 清屏
  61   1          delay_ms(2);                // 清屏指令需要较长的处理时间
  62   1      }
  63          
  64          /*******************************************************************************
  65          * 函 数 名: LCD1602_clear
  66          * 功能描述: 快速清屏
  67          *******************************************************************************/
  68          void LCD1602_clear(void)
  69          {
  70   1          LCD1602_write_cmd(0x01);    // 写入清屏指令
  71   1          delay_ms(2);
  72   1      }
  73          
  74          /*******************************************************************************
  75          * 函 数 名: LCD1602_Position
  76          * 功能描述: 设置显示光标指针坐标
  77          *******************************************************************************/
  78          void LCD1602_Position(u8 row, u8 col)
  79          {
  80   1          u8 position;
  81   1          row--; col--;               // 将人机直观坐标(1~2, 1~16)转换为标准底层数组坐标(0~1, 
             -0~15)
  82   1          if (row == 0)
  83   1              position = 0x80 | col;  // 第一行 DDRAM 起始地址 0x00
  84   1          else
  85   1              position = 0x80 | 0x40 | col; // 第二行 DDRAM 起始地址 0x40
  86   1          LCD1602_write_cmd(position);
  87   1      }
  88          
  89          /*******************************************************************************
  90          * 函 数 名: LCD1602_display
  91          * 功能描述: 流式打印字符串
  92          *******************************************************************************/
  93          void LCD1602_display(u8 row, u8 col, u8 *str)
  94          {
  95   1          LCD1602_Position(row, col);
  96   1          while (*str != '\0')
  97   1          {
  98   2              LCD1602_write_data(*str++);
  99   2          }
 100   1      }
 101          
 102          /*******************************************************************************
 103          * 函 数 名: LCD1602_display_char
 104          * 功能描述: 供主程序超低消耗局部动态刷新数字、小数点、密码星号的核心底层
 105          *******************************************************************************/
 106          void LCD1602_display_char(u8 row, u8 col, u8 ch)
 107          {
 108   1          LCD1602_Position(row, col); // 精准定位单个字符坐标
 109   1          LCD1602_write_data(ch);     // 仅刷新单点，不影响其余画面，彻底免除清屏闪烁
 110   1      }


