 498          /* 选项六：上位机流式串口可见 ASCII 字符流解析显示 */
 499          static void uart_service(void){    
 500   1          u8 rx;    
 501   1          if (first_flag) {        
 502   2              first_flag = 0; LCD1602_clear();        
 503   2              LCD1602_display(1, 2, "UART Receiver");       
 504   2              LCD1602_display(2, 1, "Waiting Link...");        
 505   2              UART_SetMode(1);                    
 506   2              UART_SendString("UART Mode Ready!\r\n");   
 507   2          }    
 508   1          rx = UART_Service();   
 509   1          if (rx != 0xFF) {        
 510   2              LCD1602_display(2, 1, "Char Recv: [ ]  ");       
 511   2              LCD1602_display_char(2, 13, rx);   
 512   2          }
 513   1      }
