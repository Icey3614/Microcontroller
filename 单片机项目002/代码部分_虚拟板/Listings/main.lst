 245          /* ==================== 各实用功能业务模块服务函数 ==================== */
 246          
 247          /* 密码安全校验关卡 */
 248          static void pwd_input_service(void){    
 249   1          if (need_clear) { need_clear = 0; LCD1602_clear(); }
 250   1          if (first_flag) {        
 251   2              first_flag = 0;
 252   2              pwd_idx = 0;        
 253   2              LCD1602_display(1, 2, "Enter Password");        
 254   2              LCD1602_display(2, 6, "[   ]");
 255   2          }    
 256   1          if (matrix_key == 0) return;
 257   1          if (calc_is_digit(matrix_key) && pwd_idx < 3) {        
 258   2              pwd_buffer[pwd_idx] = calc_get_digit(matrix_key);
 259   2              LCD1602_display_char(2, 7 + pwd_idx, '*'); // 压下瞬间直接丝滑打出掩码        
 260   2              pwd_idx++;
 261   2              if (pwd_idx == 3) {            
 262   3                  delay_ms(400);
 263   3                  if (pwd_buffer[0] == 1 && pwd_buffer[1] == 2 && pwd_buffer[2] == 3) {                
 264   4                      system_state = STATE_MENU;
 265   4                      reset_runtime(); // 密码验证通过，后台秒表此时开始精确运行计时
 266   4                  } else {                
 267   4                      LCD1602_display(2, 2, "Wrong Pwd!  ");
 268   4                      delay_ms(1000);            
 269   4                  }            
 270   3                  first_flag = 1; need_clear = 1;
 271   3              }    
 272   2          } 
 273   1      }
