 175          static void system_init(void){    
 176   1          P1 = 0xFF;
 177   1          P0 = 0xFF;         // 释放液晶并行数据总线通道    
 178   1          Main_XPT_CS = 1;
 179   1          Main_DS_DQ  = 1;   // 释放DS18B20单总线    
 180   1          Beep        = 1;
 181   1          T0_init();         // 挂载Timer0核心分发器    
 182   1          T1_init();         // 初始化Timer1音调发生器    
 183   1          T2_init();
 184   1          delay_ms(100);     // 预留足额时间等待液晶物理总线稳态    
 185   1          LCD1602_init(); 
 186   1      }
