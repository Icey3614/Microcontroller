 152          void main(void){    
 153   1          u8 i;
 154   1          system_init();      // 执行引脚强制释放与外设默认初设    
 155   1          delay_ms(200);    
 156   1          EA = 1;
 157   1          
 158   1          // 50次高频盲扫，洗净 Proteus 上电瞬间准双向口产生的漏电假键值    
 159   1          for (i = 0; i < 50; i++) {        
 160   2              delay_ms(5);
 161   2              matrix_key = key_get_value();    
 162   2          }    
 163   1          matrix_key = 0;
 164   1          
 165   1          while (1)    
 166   1          {        
 167   2              matrix_key = key_get_value();
 168   2              state_machine();
 169   2          } 
 170   1      }
