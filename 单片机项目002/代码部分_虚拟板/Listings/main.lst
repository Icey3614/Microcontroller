  65   1          LCD1602_display_char(row, col, num / 10 + '0');
  66   1          LCD1602_display_char(row, col + 1, num % 10 + '0');
  67   1      }
  68          
  69          void LCD_DisplayNum4(u8 row, u8 col, u16 num){    
  70   1          LCD1602_display_char(row, col,     num / 1000 + '0');
  71   1          LCD1602_display_char(row, col + 1, (num % 1000) / 100 + '0');
  72   1          LCD1602_display_char(row, col + 2, (num % 100) / 10 + '0');
  73   1          LCD1602_display_char(row, col + 3, num % 10 + '0');
  74   1      }
