  76          void LCD_DisplayTemp(u8 row, u8 col, float temp){    
  77   1          int temp_int;
  78   1          if (temp < 0) {        
  79   2              LCD1602_display_char(row, col, '-');        
  80   2              temp = -temp;
  81   2          } else {        
  82   2              LCD1602_display_char(row, col, ' ');
  83   2          }    
  84   1          temp_int = (int)(temp * 100.0f);    
  85   1          LCD1602_display_char(row, col + 1, temp_int / 1000 + '0');
  86   1          LCD1602_display_char(row, col + 2, (temp_int % 1000) / 100 + '0');    
  87   1          LCD1602_display_char(row, col + 3, '.');
  88   1          LCD1602_display_char(row, col + 4, (temp_int % 100) / 10 + '0');    
  89   1          LCD1602_display_char(row, col + 5, temp_int % 10 + '0');
  90   1          LCD1602_display_char(row, col + 6, 0xDF); // LCD1602内置字库的 '°' 符号    
  91   1          LCD1602_display_char(row, col + 7, 'C');
  92   1      }
