 395   3                      LCD1602_clear();               
 396   3                      LCD1602_display(1, 1, "Calc Mode: S13=.");                
 397   3                      first_num = calc_get_digit(matrix_key);                
 398   3                      has_dot = 0; dot_cnt = 0;                
 399   3                      LCD_DisplayLong(2, 1, first_num);                
