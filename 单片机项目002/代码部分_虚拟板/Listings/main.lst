 275          /* 功能选择主菜单（手动切页重构版） */
 276          static void menu_screen_service(void){    
 277   1          static u8 idata page = 0; // 3个界面分布 -> 0:功能1&2, 1:功能3&4, 2:功能5&6
 278   1      
 279   1          if (need_clear) { need_clear = 0; LCD1602_clear(); }
 280   1          
 281   1          /* 1. 渲染当前手动选中的 LCD 菜单页面 */    
 282   1          if (first_flag) {        
 283   2              first_flag = 0;
 284   2              LCD1602_display(1, 1, "Select Function:");        
 285   2              switch (page) {            
 286   3                  case 0: LCD1602_display(2, 1, "1:Bri   2:Temp  "); break;           
 287   3                  case 1: LCD1602_display(2, 1, "3:Music 4:Calc  "); break;           
 288   3                  case 2: LCD1602_display(2, 1, "5:Time  6:UART  "); break;           
 289   3                  default: page = 0; break;       
 290   3              }    
 291   2          }    
 292   1      
 293   1          /* 2. 检测独立按键 K3 单击 (向左/上循环切页) */
 294   1          if (key_check(KEY_3, KEY_SINGLE)) {
 295   2              if (page == 0) {
 296   3                  page = 2; // 在最左侧界面左切时 -> 闭环切换到最右侧界面
 297   3              } else {
 298   3                  page--;
C51 COMPILER V9.60.7.0   MAIN                                                              06/06/2026 16:03:52 PAGE 6   

 299   3              }
 300   2              first_flag = 1; // 触发 LCD 重新刷新渲染
 301   2          }
 302   1      
 303   1          /* 3. 检测独立按键 K4 单击 (向右/下循环切页) */
 304   1          if (key_check(KEY_4, KEY_SINGLE)) {
 305   2              if (page == 2) {
 306   3                  page = 0; // 在最右侧界面右切时 -> 闭环切换到最左侧界面
 307   3              } else {
 308   3                  page++;
 309   3              }
 310   2              first_flag = 1; // 触发 LCD 重新刷新渲染
 311   2          }
 312   1          
 313   1          /* 4. 根据矩阵键值 1~6 零延迟直接切入对应工具 */    
 314   1          switch (matrix_key)    
 315   1          {        
 316   2              case MATRIX_S1: system_state = STATE_SHOW_BRIGHT; first_flag = 1; need_clear = 1; break;       
 317   2              case MATRIX_S2: system_state = STATE_SHOW_TEMP;   first_flag = 1; need_clear = 1; break;       
 318   2              case MATRIX_S3: system_state = STATE_MUSIC;       first_flag = 1; need_clear = 1; break;       
 319   2              case MATRIX_S4: system_state = STATE_CALC;        first_flag = 1; need_clear = 1; break;       
 320   2              case MATRIX_S5: system_state = STATE_SHOW_TIME;   first_flag = 1; need_clear = 1; break;       
 321   2              case MATRIX_S6: system_state = STATE_UART;        first_flag = 1; need_clear = 1; break;       
 322   2              default: break;    
 323   2          } 
 324   1      }
