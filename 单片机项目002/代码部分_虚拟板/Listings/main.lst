  94          void LCD_DisplayFixedPoint(u8 row, u8 col, long num){    
  95   1          u8 buf[11];
  96   1          signed char i = 0;    
  97   1          if (num < 0) {        
  98   2              LCD1602_display_char(row, col++, '-');
  99   2              num = -num;    
 100   2          }    
 101   1          buf[0] = (num % 10) + '0';
 102   1          buf[1] = ((num / 10) % 10) + '0';    
 103   1          buf[2] = ((num / 100) % 10) + '0';
 104   1          num /= 1000;    
 105   1          i = 3;    
 106   1          while (num > 0) {        
 107   2              buf[i++] = (num % 10) + '0';
 108   2              num /= 10;    
 109   2          }    
 110   1          for (i = i - 1; i >= 0; i--) {        
 111   2              if (i == 1) LCD1602_display_char(row, col++, '.');
 112   2              LCD1602_display_char(row, col++, buf[i]);    
C51 COMPILER V9.60.7.0   MAIN                                                              06/06/2026 16:03:52 PAGE 3   

 113   2          }
 114   1      }
