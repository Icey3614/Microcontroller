 515          /* ==================== 矩阵键值基础转换映射工具 ==================== */
 516          static u8 calc_get_digit(u8 key){    
 517   1          if (key == MATRIX_S1)  return 1;   
 518   1          if (key == MATRIX_S2)  return 2;    
 519   1          if (key == MATRIX_S3)  return 3;   
 520   1          if (key == MATRIX_S5)  return 4; 
 521   1          if (key == MATRIX_S6)  return 5;   
 522   1          if (key == MATRIX_S7)  return 6;    
 523   1          if (key == MATRIX_S9)  return 7; 
 524   1          if (key == MATRIX_S10) return 8;   
 525   1          if (key == MATRIX_S11) return 9;    
 526   1          if (key == MATRIX_S14) return 0;   
 527   1          return 0;
 528   1      }
 529          
 530          static bit calc_is_digit(u8 key){    
 531   1          return (key == MATRIX_S1  || key == MATRIX_S2  || key == MATRIX_S3  ||            
 532   1                  key == MATRIX_S5  || key == MATRIX_S6  || key == MATRIX_S7  ||            
 533   1                  key == MATRIX_S9  || key == MATRIX_S10 || key == MATRIX_S11 ||            
 534   1                  key == MATRIX_S14);
 535   1      }


