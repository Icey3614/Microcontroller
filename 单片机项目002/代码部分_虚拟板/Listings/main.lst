 371          /* 选项四：支持两位小数的定点数计算器（彻底解决仿真不刷新与乱码问题） */
 372          static void calc_service(void){    
 373   1          u8 d;   
 374   1          if (first_flag) {        
 375   2              first_flag = 0;        
 376   2              LCD1602_clear();        
 377   2              LCD1602_display(1, 1, "Calc Mode: S13=.");       
 378   2              first_num = 0; second_num = 0; oper = 0;        
