 384   2              if (calc_state == CALC_INPUT_FIRST || calc_state == CALC_INPUT_SECOND) {            
 385   3                  has_dot = 1;           
 386   3                  dot_cnt = 0;            
 387   3                  LCD1602_display_char(2, 15, '.'); // 在屏幕右下角点亮一个点，给予用户视觉反
             -馈       
 388   3              }        
 389   2              return;   
 390   2          }    
 391   1          switch (calc_state)    
 392   1          {        
 393   2              case CALC_WAIT_FIRST:            
