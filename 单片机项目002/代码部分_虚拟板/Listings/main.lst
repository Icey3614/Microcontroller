 116          void LCD_DisplayLong(u8 row, u8 col, long num){    
 117   1          u8 buf[11];
 118   1          signed char i = 0;    
 119   1          if (num == 0) {        
 120   2              LCD1602_display_char(row, col, '0');
 121   2              return;    
 122   2          }    
 123   1          if (num < 0) {        
 124   2              LCD1602_display_char(row, col++, '-');
 125   2              num = -num;    
 126   2          }    
 127   1          while (num > 0) {        
 128   2              buf[i++] = num % 10 + '0';
 129   2              num /= 10;    
 130   2          }    
 131   1          for (i = i - 1; i >= 0; i--) {        
 132   2              LCD1602_display_char(row, col++, buf[i]);
 133   2          } 
 134   1      }
