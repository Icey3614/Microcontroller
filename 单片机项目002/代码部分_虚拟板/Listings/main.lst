 188          /********************************************************************************
 189          * 函 数 名: state_machine
 190          *******************************************************************************/
 191          static void state_machine(void){    
 192   1          static u16 idata power_tick = 0;
 193   1          
 194   1          /* 1. 全局独立按键 K1 开关机模块检测 (长按3秒) */    
 195   1          if (key_check(KEY_1, KEY_DOWN)) power_tick = 0;
 196   1          if (key_check(KEY_1, KEY_HOLD)) {        
 197   2              if (sysTick_checked(&power_tick, 3000)) {            
 198   3                  if (system_state == STATE_OFF) {                
 199   4                      system_state = STATE_PWD_INPUT;
 200   4                  } else {                
 201   4                      Buzzer_Stop();
 202   4                      Beep = 1;        // 关机切断所有声响                
 203   4                      system_state = STATE_OFF;
 204   4                  }            
 205   3                  first_flag = 1; need_clear = 1;            
 206   3                  return;
 207   3              }    
 208   2          }    
 209   1          
 210   1          /* 2. 全局独立按键 K2 安全退回主菜单模块检测 (长按1秒) */    
 211   1          if (system_state > STATE_MENU) {        
 212   2              if (key_check(KEY_2, KEY_LONG) || key_check(KEY_2, KEY_REPEAT)) {            
 213   3                  Buzzer_Stop();
 214   3                  Beep = 1;            // 强制掐断音乐和可能存在的超温长鸣            
 215   3                  system_state = STATE_MENU;
 216   3                  first_flag = 1; need_clear = 1;            
 217   3                  return;
 218   3              }    
 219   2          }    
 220   1          
 221   1          /* 3. 核心主状态机调度分布 */    
 222   1          switch (system_state)    
 223   1          {        
 224   2              case STATE_OFF:            
 225   2                  if (first_flag) {                
 226   3                      first_flag = 0;
 227   3                      LCD1602_clear();                
 228   3                      LCD1602_display(1, 4, "Desktop Toy");                
 229   3                      LCD1602_display(2, 2, "Hold K1 3s ON");                
 230   3                      reset_runtime();
 231   3                  }            
 232   2                  break;        
 233   2              case STATE_PWD_INPUT: pwd_input_service();  break;
 234   2              case STATE_MENU:      menu_screen_service(); break;        
 235   2              case STATE_SHOW_BRIGHT: bright_service();   break;        
 236   2              case STATE_SHOW_TEMP:   temp_service();     break;
C51 COMPILER V9.60.7.0   MAIN                                                              06/06/2026 16:03:52 PAGE 5   

 237   2              case STATE_MUSIC:       music_service();    break;        
 238   2              case STATE_CALC:        calc_service(); break;        
 239   2              case STATE_SHOW_TIME:   time_service();     break;        
 240   2              case STATE_UART:        uart_service();     break;
 241   2              default: system_state = STATE_OFF; first_flag = 1; break;
 242   2          } 
 243   1      }
