   1          #include "timer.h"
   2          #include "key.h"
   3          #include "key_matrix.h"
   4          #include "buzzer.h"
   5          
   6          u16 idata sysTick = 0;  //无static，即全局可以访问
   7          u16 idata runtime_hours = 0;//时
   8          u16 idata runtime_minutes = 0;//分
   9          u16 idata runtime_seconds = 0;//秒
  10          u32 idata runtime_total_seconds = 0;//总运行秒
  11          static u16 idata runtime_tick = 0;  //只有在timer.c中可以访问
  12          /*
  13          它的任务，就是在单片机刚开机的时候，
  14          把定时器0配置成你需要的“1毫秒节拍器”模式，
  15          为整个系统的按键扫描和事件倒计时提供精准的时间基准 。
  16          定时器：
  17          每次定时器溢出之后会触发中断，这时会向CPU发出中断请求，CPU就会转向中断程�
             -��，
  18          这时将一些想要每个一段时间的执行其中的程序放入其中，
  19          就可以实现每隔一段时间就执行的效果
  20          也就是说定时器的计数不是像delay一样在CPU中执行的，
  21          而是有一个专门的寄存器。只要寄存器溢出，发出中断请求即可
  22          当然不是随便编写一个代码就可使用定时器还需要用到
  23              ET0 = 1;
  24              TR0 = 1;
  25          这样的句式写在代码中，这样才会启动定时器
  26          */
  27          void T0_init(void)
  28          {
  29   1          TMOD = (TMOD & 0xF0) | 0x01; // T0 16位定时模式
  30   1          // 8位特殊功能寄存器
  31   1          TH0 = 0xFC;      // (Timer 0 High Byte)定时器0的高8位。
  32   1          TL0 = 0x66;      // (Timer 0 Low Byte)定时器0的低8位。1ms 定时基准初值
  33   1        /*
  34   1        给定时器的计数寄存器赋初值
  35   1        因为 16 位寄存器放不下，所以拆开来放：
  36   1        高8位 TH0 放 0xFC，低8位 TL0 放 0x66 。  
  37   1        */
  38   1          ET0 = 1; //打开中断允许开关
  39   1          TR0 = 1; //摁下启动秒表
  40   1      }
  41          
  42          /*
  43          让蜂鸣器按要求运行：
  44          定时器1 在项目里主要负责给蜂鸣器（Buzzer）提供高频的翻转电平来发声。
  45          如果开机直接 TR1 = 1; ET1 = 1;，蜂鸣器会在开机瞬间发出刺耳的盲音。
  46          */
  47          void T1_init(void)
  48          {
  49   1          TMOD = (TMOD & 0x0F) | 0x10; // T1 16位定时模式
  50   1          TH1 = 0xFC; TL1 = 0x66;
  51   1          ET1 = 0; TR1 = 0;
  52   1      }
  53          
C51 COMPILER V9.60.7.0   TIMER                                                             06/03/2026 16:13:02 PAGE 2   

  54          void T2_init(void) { ET2 = 0; TR2 = 0; } // 弃用并关锁 T2，防止总线死锁
  55          // 在整个项目中不使用定时器2
  56          
  57          /*
  58          定时器0的中断程序：
  59          定时器0在开机后，每1ms就自动执行一次，
  60          同时这个中断程序也是每1ms执行一次
  61          */
  62          void T0_ISR(void) interrupt 1
  63          {
  64   1          TH0 = 0xFC; TL0 = 0x66; // 硬件级重装载
  65   1      
  66   1          MatrixKey_Tick(); // 1ms 矩阵扫描
  67   1          key_tick();       // 1ms 独立键扫描
  68   1          Buzzer_BeatTick(); // 1ms 音乐节拍倒计时
  69   1      
  70   1          sysTick++;  //1ms滴答
  71   1          runtime_tick++; //运行时间滴答（局部）
  72   1          //时分秒的计算
  73   1          if (runtime_tick >= 1000)
  74   1          {
  75   2              runtime_tick = 0;
  76   2              runtime_total_seconds++;
  77   2              runtime_seconds++;
  78   2              if (runtime_seconds >= 60) {
  79   3                  runtime_seconds = 0; runtime_minutes++;
  80   3                  if (runtime_minutes >= 60) { runtime_minutes = 0; runtime_hours++; }
  81   3              }
  82   2          }
  83   1      }
  84          
  85          //无中断影响的获取当前的滴答时间戳
  86          u16 get_current_sysTick(void)
  87          {
  88   1          u16 t;
  89   1          EA = 0; t = sysTick; EA = 1;//关；记录；开
  90   1          return t;
  91   1      }
  92          
  93          //u16，无符号型数
  94          bit sysTick_checked(u16 *last_tick, u16 interval_ms)
  95          {
  96   1          u16 current = get_current_sysTick();//获得当前的时间戳
  97   1          if (*last_tick == 0) { *last_tick = current; return 0; }
  98   1          //含义：如果传入的闹钟变量 *last_tick 还是 0（说明是刚开机第一次运行这个功�
             -��）
  99   1          //它会先把当前的系统时间 current 赋值给这个闹钟变量存起来 ， 
 100   1          //然后返回 0（代表时间还没到） 。
 101   1          if (current - *last_tick >= interval_ms) { *last_tick = current; return 1; }
 102   1          //时间间隔大于规定计数，开始执行后续程序
 103   1          return 0;
 104   1          //时间间隔还没到，继续计时
 105   1      }
 106          
 107          //时间重置，关机时调用
 108          void reset_runtime(void)
 109          {
 110   1          runtime_hours = 0; runtime_minutes = 0; runtime_seconds = 0;
 111   1          runtime_total_seconds = 0; runtime_tick = 0;
 112   1      }


