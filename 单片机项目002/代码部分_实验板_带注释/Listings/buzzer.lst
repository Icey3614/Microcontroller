  70   1          beat_ms_remain = 0; // 
  71   1          is_playing = 1; // 
  72   1      }
  73          
  74          void Buzzer_Stop(void)
  75          {
  76   1          TR1 = 0;                     // 停止 Timer1
  77   1          ET1 = 0;                     // 关闭 Timer1 中断 
  78   1          is_playing = 0; // [cite: 1057]
  79   1          Beep = 1;                    // 强行拉高释放 P2.5 总线，供 LCD1602 正常刷新 
  80   1      }
  81          
  82          bit Buzzer_IsPlaying(void)
