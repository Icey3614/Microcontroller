  87          /*******************************************************************************
  88          * 函 数 名: Buzzer_BeatTick
  89          * 功能描述: 非阻塞毫秒时钟减法器，必须由 Timer0 的 1ms 中断服务程序（T0_ISR）�
             -�用 
  90          *******************************************************************************/
  91          void Buzzer_BeatTick(void)
  92          {
  93   1          if (is_playing && beat_ms_remain > 0)
  94   1          {
  95   2              beat_ms_remain--; 
  96   2      
  97   2              // 核心切音逻辑：当音符即将播放完毕，进入最后的静音窗口时，强行关�
             -�声音 
  98   2              if (beat_ms_remain <= SILENT_GAP_MS && m != 0) 
  99   2              {
 100   3                  TR1 = 0;             // 关闭定时器 
 101   3                  ET1 = 0;             // 关中断 
 102   3                  Beep = 1;            // 释放总线，制造完美声学间隙 
 103   3              }
 104   2          }
 105   1      }
