 108          * 函 数 名: Buzzer_Service
 109          * 功能描述: 主状态机轮询函数，置于 main.c 的主循环内高效运转 [cite: 1083, 1084]
 110          *******************************************************************************/
 111          void Buzzer_Service(void)
 112          {
 113   1          u8 note_type; //
 114   1          u8 duration; //
 115   1      
 116   1          if (!is_playing) return; //
 117   1          if (beat_ms_remain > 0) return; // 当前音符（含切音期）未消耗完毕，直接退出
 118   1      
 119   1          // 读取当前谱表节点信息
 120   1          note_type = qinghuaci[song_index][0]; //
 121   1          duration  = qinghuaci[song_index][1]; //
 122   1      
 123   1          // 1. 判断是否到达歌曲终点 
 124   1          if (note_type == 0xFF) // 
 125   1          {
 126   2              TR1 = 0; ET1 = 0; Beep = 1; //
 127   2              song_index = 0;                            // 自动回到第一首开头循环播放 [cite: 1099]
 128   2              beat_ms_remain = 30 * BASE_BEAT_MS;        // 曲终休止停顿 [cite: 1100]
 129   2              return; // 
 130   2          }
 131   1      
 132   1          // 2. 解析当前音律并转换为毫秒级时间窗
 133   1          m = note_type; // 
 134   1          beat_ms_remain = (u16)duration * BASE_BEAT_MS; // 
 135   1      
 136   1          // 3. 驱动硬件执行对应发声时序 
 137   1          if (m == 0x00) // 简谱中的休止符 '0' 
 138   1          {
 139   2              TR1 = 0; // 
 140   2              ET1 = 0; //
 141   2              Beep = 1;  // 维持静音 
 142   2          }
 143   1          else           // 有音高振幅的标准音符 
 144   1          {
 145   2              TH1 = T[m][0]; // 
 146   2              TL1 = T[m][1]; // 
 147   2              TR1 = 1;   // 唤醒定时器 
 148   2              ET1 = 1;   // 开启发声中断 
 149   2          }
 150   1      
 151   1          song_index++;  // 指针无阻塞地平滑递增，指向下一个待播放音符
 152   1      }


