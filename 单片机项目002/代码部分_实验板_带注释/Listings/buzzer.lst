  56          /*******************************************************************************
  57          * 函 数 名: T1_ISR_Buzzer (中断号 3)
  58          * 功能描述: 纯净的独立音调发生器，排除Timer0多任务带来的时序挤压 
  59          *******************************************************************************/
  60          void T1_ISR_Buzzer(void) interrupt 3
  61          {
  62   1          Beep = !Beep;                // 物理高低电平翻转，驱动被动式蜂鸣器发声
  63   1          TH1 = T[m][0];               // 重新装载高8位初值 
  64   1          TL1 = T[m][1];               // 重新装载低8位初值
  65   1      }
  66          
  67          void Buzzer_PlayQingHuaCi(void)
  68          {
