   1          /*-------------------------------------------------------------------------
   2           * 模块名称: LCD1602 液晶显示驱动模块（真实实验板全兼容及全局时序修复版）
   3           * 文件名称: lcd1602.c
   4           * 优化特性: 
   5           * 1. 重新实现全局 delay_ms() 函数，彻底根除 main.c 跑飞死机问题。
   6           * 2. 严格遵循工业标准执行 3 次 0x38 连续唤醒，彻底激活真实硬件的第二行显示�
             -��
   7           * 3. 强行拉低 RW (P2.5)，断绝蜂鸣器复用对液晶内核的电平污染。
   8           --------------------------------------------------------------------------*/
   9          #include "lcd1602.h"
  10          #include "intrins.h"
  11          
  12          #define LCD1602_DATAPORT P0
  13          
  14           void delay_ms(u16 time) //延时函数
  15          {
  16   1          u16 i, j;
  17   1          for (i = 0; i < time; i++)
  18   1              for (j = 0; j < 113; j++);
  19   1      }
  20          
  21          /*******************************************************************************
  22           * 函 数 名: LCD1602_write_cmd
  23           * 功能描述: 向液晶写入控制指令
  24           *******************************************************************************/
  25          void LCD1602_write_cmd(u8 cmd)  //读取命令函数
  26          {
  27   1          LCD1602_DATAPORT = 0xFF; // 清空总线，防止残留电平干扰（P0）
  28   1          LCD1602_RS = 0;          // 选择指令寄存器
  29   1          LCD1602_RW = 0;          // 强行拉低RW（强制切回写模式，屏蔽蜂鸣器干扰）
  30   1          _nop_();
  31   1          
  32   1          LCD1602_DATAPORT = cmd;  // 送入指令
  33   1          _nop_();
  34   1          
  35   1          LCD1602_E = 1;           // 拉高使能脚
  36   1          _nop_(); _nop_(); _nop_(); // 加宽使能脉冲，照顾真实硬件物理建立时间
  37   1          LCD1602_E = 0;           // 捕获下降沿，写入指令
  38   1          
  39   1          delay_ms(2);             // 留出 2ms 处理指令的时间
  40   1      }
  41          
  42          /*******************************************************************************
  43           * 函 数 名: LCD1602_write_data
  44           * 功能描述: 向液晶写入显示内容
  45           *******************************************************************************/
  46          void LCD1602_write_data(u8 dat)   //ASCII数据写入函数
  47          {
  48   1          LCD1602_DATAPORT = 0xFF; 
  49   1          LCD1602_RS = 1;          // 选择数据寄存器
  50   1          LCD1602_RW = 0;          // 强行拉低RW，屏蔽蜂鸣器干扰
  51   1          _nop_();
  52   1          
  53   1          LCD1602_DATAPORT = dat;  // 送入数据
C51 COMPILER V9.60.7.0   LCD1602                                                           06/03/2026 16:13:01 PAGE 2   

  54   1          _nop_();
  55   1          
  56   1          LCD1602_E = 1;
  57   1          _nop_(); _nop_(); _nop_(); // 加宽使能脉冲
  58   1          LCD1602_E = 0;           // 捕获下降沿，写入数据
  59   1          
  60   1          delay_ms(1);             // 留出 1ms 写入等待
  61   1      }
  62          
  63          /*******************************************************************************
  64           * 函 数 名: LCD1602_init
  65           * 功能描述: 工业级 LCD1602 硬件安全唤醒与初始化时序
  66           *******************************************************************************/
  67          void LCD1602_init(void)          //初始化函数
  68          {
  69   1          LCD1602_E = 0;
  70   1          delay_ms(15);           // 1. 上电后硬件硬延迟 15ms，等待液晶自身电压稳态
  71   1          
  72   1          // 2. 连续 3 次写入 0x38 强行唤醒并锁死“两行显示模式”
  73   1          LCD1602_write_cmd(0x38);
  74   1          delay_ms(5);
  75   1          LCD1602_write_cmd(0x38);
  76   1          delay_ms(5);
  77   1          LCD1602_write_cmd(0x38);
  78   1          delay_ms(5);
  79   1          
  80   1          // 3. 此时功能设定正式生效，配置常规显示参数
  81   1          LCD1602_write_cmd(0x38); // 开启双行显示，5x7点阵
  82   1          LCD1602_write_cmd(0x0C); // 开启无光标显示
  83   1          LCD1602_write_cmd(0x06); // 文字输入后光标自动右移
  84   1          LCD1602_write_cmd(0x01); // 强清屏
  85   1          delay_ms(10);            // 清屏后必须给予长延时
  86   1      }
  87          
  88          /*******************************************************************************
  89           * 函 数 名: LCD1602_display
  90           * 功能描述: 动态坐标计算显示英文字串
  91           *******************************************************************************/
  92          void LCD1602_display(u8 row, u8 col, u8 *str) 
  93          {//字符串显示函数（从第几行，第几列开始）
  94   1          u8 addr;
  95   1          if (row == 1)
  96   1              addr = 0x80 + (col - 1); // 第一行基地址 0x80
  97   1          else
  98   1              addr = 0xC0 + (col - 1); // 第二行基地址 0xC0
  99   1      
 100   1          LCD1602_write_cmd(addr);     // 寻址位置
 101   1      
 102   1          while (*str != '\0')
 103   1          {
 104   2              LCD1602_write_data(*str);
 105   2              str++;
 106   2          }
 107   1      }
 108          
 109          /*******************************************************************************
 110           * 函 数 名: LCD1602_display_char
 111           * 功能描述: 在指定行列位置精准写入单个可见字符
 112           * 用于上位机串口通信
 113           *******************************************************************************/
 114          void LCD1602_display_char(u8 row, u8 col, u8 chr)
 115          {
C51 COMPILER V9.60.7.0   LCD1602                                                           06/03/2026 16:13:01 PAGE 3   

 116   1          u8 addr;
 117   1          if (row == 1)
 118   1              addr = 0x80 + (col - 1);
 119   1          else
 120   1              addr = 0xC0 + (col - 1);
 121   1      
 122   1          LCD1602_write_cmd(addr);
 123   1          LCD1602_write_data(chr);
 124   1      }
 125          
 126          /*******************************************************************************
 127           * 函 数 名: LCD1602_clear
 128           * 功能描述: 全屏一键清除刷新
 129           *******************************************************************************/
 130          void LCD1602_clear(void)  //清屏函数
 131          {
 132   1          LCD1602_write_cmd(0x01);
 133   1          delay_ms(5); // 给足液晶芯片硬件擦除时间
 134   1      }


