 277          static void system_init(void)
 278          {    
 279   1          P1 = 0xFF;
 280   1          P0 = 0xFF;         // 释放液晶并行数据总线通道    
 281   1          Main_XPT_CS = 1;
 282   1          Main_DS_DQ  = 1;   // 释放DS18B20单总线    
 283   1          Beep        = 1;
 284   1          T0_init();         // 挂载Timer0核心分发器    
 285   1          T1_init();         // 初始化Timer1音调发生器    
 286   1          T2_init();
 287   1          delay_ms(100);     // 预留足额时间等待液晶物理总线稳态    
