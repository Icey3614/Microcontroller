 397          /* 功能选择主菜单 */
 398          static void menu_screen_service(void)
 399          {    
 400   1          static u8 idata page = 0; // 3个界面分布 -> 0:功能1&2, 1:功能3&4, 2:功能5&6
 401   1      
 402   1          if (need_clear) { need_clear = 0; LCD1602_clear(); }
 403   1          
 404   1          /* 1. 渲染当前手动选中的 LCD 菜单页面 */    
 405   1          if (first_flag) {
 406   2              first_flag = 0;
 407   2              LCD1602_display(1, 1, "Select Function:");        
 408   2              switch (page) {            
 409   3                  case 0: LCD1602_display(2, 1, "1:Bri   2:Temp  "); break;           
 410   3                  case 1: LCD1602_display(2, 1, "3:Music 4:Calc  "); break;           
