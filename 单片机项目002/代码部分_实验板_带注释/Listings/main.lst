 361          /* 密码安全校验关卡 */
 362          // 密码为“123”
 363          static void pwd_input_service(void)
 364          {    
 365   1          if (need_clear) { need_clear = 0; LCD1602_clear(); }
 366   1          if (first_flag) 
 367   1          {        
 368   2              first_flag = 0;
 369   2              pwd_idx = 0;        
 370   2              LCD1602_display(1, 2, "Enter Password");        
 371   2              LCD1602_display(2, 6, "[   ]");// 显示密码界面
 372   2          }    
 373   1          if (matrix_key == 0) return;
 374   1          if (calc_is_digit(matrix_key) && pwd_idx < 3) 
 375   1          {        
 376   2              pwd_buffer[pwd_idx] = calc_get_digit(matrix_key);
 377   2              LCD1602_display_char(2, 7 + pwd_idx, '*'); // 压下瞬间直接掩码显示        
 378   2              pwd_idx++;
 379   2              if (pwd_idx == 3) 
 380   2              {            
 381   3                  delay_ms(400);
 382   3                  if (pwd_buffer[0] == 1 && pwd_buffer[1] == 2 && pwd_buffer[2] == 3)
 383   3                  {                
 384   4                      system_state = STATE_MENU;
 385   4                      reset_runtime(); // 密码验证通过，后台秒表开始精确运行计时
 386   4                  } 
 387   3                  else 
 388   3                  {                
 389   4                      LCD1602_display(2, 2, "Wrong Pwd!  ");
 390   4                      delay_ms(1000);            
 391   4                  }            
 392   3                  first_flag = 1; need_clear = 1;
 393   3              }    
 394   2          } 
 395   1      }
