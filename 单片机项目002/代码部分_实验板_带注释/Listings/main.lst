 411   3                  case 2: LCD1602_display(2, 1, "5:Time  6:UART  "); break;           
 412   3                  default: page = 0; break;       
 413   3              }    
 414   2          }    
 415   1      
 416   1          /* 2. 检测独立按键 K3 单击 (向左/上循环切页) */
 417   1          if (key_check(KEY_3, KEY_SINGLE)) {
 418   2              if (page == 0) {
 419   3                  page = 2; // 在最左侧界面左切时 -> 闭环切换到最右侧界面
 420   3              } else {
 421   3                  page--;
 422   3              }
 423   2              first_flag = 1; // 触发 LCD 重新刷新渲染
 424   2          }
 425   1      
 426   1          /* 3. 检测独立按键 K4 单击 (向右/下循环切页) */
 427   1          if (key_check(KEY_4, KEY_SINGLE)) 
 428   1          {
 429   2              if (page == 2) 
 430   2              {
 431   3                  page = 0; // 在最右侧界面右切时 -> 闭环切换到最左侧界面
 432   3              } 
 433   2              else 
 434   2              {
 435   3                  page++;
 436   3              }
 437   2              first_flag = 1; // 触发 LCD 重新刷新渲染
 438   2          }
 439   1          
 440   1          /* 4. 根据矩阵键值 1~6 零延迟直接切入对应工具 */    
 441   1          switch (matrix_key)    
 442   1          {        
 443   2              case MATRIX_S1: system_state = STATE_SHOW_BRIGHT; first_flag = 1; need_clear = 1; break;       
 444   2              case MATRIX_S2: system_state = STATE_SHOW_TEMP;   first_flag = 1; need_clear = 1; break;       
 445   2              case MATRIX_S3: system_state = STATE_MUSIC;       first_flag = 1; need_clear = 1; break;       
 446   2              case MATRIX_S4: system_state = STATE_CALC;        first_flag = 1; need_clear = 1; break;       
 447   2              case MATRIX_S5: system_state = STATE_SHOW_TIME;   first_flag = 1; need_clear = 1; break;       
 448   2              case MATRIX_S6: system_state = STATE_UART;        first_flag = 1; need_clear = 1; break;       
 449   2              default: break;    
 450   2          } 
 451   1      }
