 179          void LCD_DisplayFixedPoint(u8 row, u8 col, long num)//带小数点的，显示最终结果
 180          // 这里的num表示原本的数*100
 181          // 这里“原本的数”是计算器运算后的结果
 182          // 专门为计算器功能量身定做的定点数（保留两位小数）高端显示工具。
 183          {
 184   1        
 185   1          u8 buf[11];// buf[11]：字符缓冲区，最多存储11个字符（负号+整数部分+小数点+两位小数+结束符）
 186   1          signed char i = 0;// 有符号字符型索引，用于记录当前填充位置
 187   1          if (num < 0)
 188   1          //发现是负数，将其转为整数，同时前方加上‘-’表明输出时为负数
 189   1          {        
 190   2              LCD1602_display_char(row, col++, '-');
 191   2            // 在当前行列位置显示'-'，然后col++让列指针后移一位
 192   2              num = -num;    
 193   2          }
 194   1          buf[0] = (num % 10) + '0';// 取个位为百分位
 195   1          buf[1] = ((num / 10) % 10) + '0'; // 取十位为十分位
 196   1          buf[2] = ((num / 100) % 10) + '0';// 取百位为个位
 197   1          num /= 1000;// // 去掉最后三位，得到整数部分
 198   1          i = 3;
 199   1          while (num > 0) 
 200   1          {        
 201   2              buf[i++] = (num % 10) + '0';
 202   2              num /= 10;    
 203   2          }    
 204   1          for (i = i - 1; i >= 0; i--) 
 205   1          {        
 206   2              if (i == 1) LCD1602_display_char(row, col++, '.');// 适时的插入小数点
 207   2              LCD1602_display_char(row, col++, buf[i]);    
 208   2          }
 209   1      }
