 642          /* ==================== 矩阵键值基础转换映射工具 ==================== */
 643          static u8 calc_get_digit(u8 key){    
 644   1          if (key == MATRIX_S1)  return 1;   
 645   1          if (key == MATRIX_S2)  return 2;    
 646   1          if (key == MATRIX_S3)  return 3;   
 647   1          if (key == MATRIX_S5)  return 4; 
 648   1          if (key == MATRIX_S6)  return 5;   
 649   1          if (key == MATRIX_S7)  return 6;    
 650   1          if (key == MATRIX_S9)  return 7; 
 651   1          if (key == MATRIX_S10) return 8;   
 652   1          if (key == MATRIX_S11) return 9;    
 653   1          if (key == MATRIX_S14) return 0;   
 654   1          return 0;
 655   1      }
C51 COMPILER V9.60.7.0   MAIN                                                              06/05/2026 19:47:35 PAGE 12  

 656          /*******************************************************************************
 657          * 函 数 名: calc_is_digit
 658          * 功能描述: 判断矩阵按键值是否属于数字键（S1~S3, S5~S7, S9~S11, S14）
 659          * 返 回 值: 1=是数字键，0=不是数字键
 660          *******************************************************************************/
 661          static bit calc_is_digit(u8 key){ 
 662   1          return (key == MATRIX_S1  || key == MATRIX_S2  || key == MATRIX_S3  ||            
 663   1                  key == MATRIX_S5  || key == MATRIX_S6  || key == MATRIX_S7  ||            
 664   1                  key == MATRIX_S9  || key == MATRIX_S10 || key == MATRIX_S11 ||            
 665   1                  key == MATRIX_S14);
 666   1      }


