 252          void main(void)// 主函数，从这里进入
 253          {    
 254   1          u8 i;
 255   1          system_init();      // 执行引脚强制释放与外设默认初设    
 256   1          delay_ms(200);    
 257   1          EA = 1;
 258   1          
 259   1          // 50次高频盲扫，洗净上电瞬间准双向口产生的漏电假键值    
 260   1          for (i = 0; i < 50; i++) 
 261   1          {        
 262   2              delay_ms(5);
 263   2              matrix_key = key_get_value();    
 264   2          }    
 265   1          matrix_key = 0;
 266   1          
 267   1          while (1)// 无线循环，开始运行
 268   1          {        
 269   2              matrix_key = key_get_value();
 270   2              state_machine();
 271   2          } 
 272   1      }
