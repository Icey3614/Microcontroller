 291          /********************************************************************************
 292          * 函数名: state_machine
 293          *******************************************************************************/
 294          static void state_machine(void)
 295          {    
 296   1          static u16 idata power_tick = 0;
 297   1          
 298   1          /* 1. 全局独立按键 K1 开关机模块检测 (长按3秒) */    
 299   1          if (key_check(KEY_1, KEY_DOWN)) power_tick = 0;// K1键刚被按下，开始计时
 300   1          if (key_check(KEY_1, KEY_HOLD)) 
 301   1          {        
 302   2              if (sysTick_checked(&power_tick, 3000)) 
 303   2              {            
 304   3                  if (system_state == STATE_OFF) //满足开机状态（3S），开机
 305   3                  {                
 306   4                      system_state = STATE_PWD_INPUT;
 307   4                  } 
 308   3                  else //另一种是关机长按3S，清除状态
 309   3                  {                
 310   4                      Buzzer_Stop();
 311   4                      Beep = 1;        // 关机切断所有声响                
 312   4                      system_state = STATE_OFF;
 313   4                  }            
 314   3                  first_flag = 1; need_clear = 1;            
 315   3                  return;
 316   3                  // 把 first_flag 和 need_clear 都置为 1（通知下一个界面重新刷文字、擦屏幕） 
 317   3                  // 然后执行 return 直接结束本轮函数，后面的代码这轮就不执行了 。
 318   3              }    
 319   2          }    
 320   1          
 321   1          /* 2. 全局独立按键 K2 安全退回主菜单模块检测 (长按1秒) */    
 322   1          if (system_state > STATE_MENU) // 判断是否处于6大功能之中
 323   1          {        
 324   2              if (key_check(KEY_2, KEY_LONG) || key_check(KEY_2, KEY_REPEAT)) //如果K2按下1S，执行回到主界面的命
             -令
 325   2              {            
 326   3                  Buzzer_Stop();
