 136          /* ==================== 自定义轻量化数字显示工具组（显示两位整数00-99） ==================== */
 137          void LCD_DisplayNum2(u8 row, u8 col, u16 num)
 138          {
 139   1      //'0' 是一个字符，在计算机内存中对应一个具体的ASCII码值（十进制48）。
 140   1      //将一个数字（0-9）加上 '0'，本质上是将数值偏移到它对应数字字符的ASCII码位置。
 141   1          LCD1602_display_char(row, col, num / 10 + '0');
 142   1          LCD1602_display_char(row, col + 1, num % 10 + '0');
 143   1      }
 144          
 145          /* ==================== 自定义轻量化数字显示工具组（显示两位整数0000-9999） ==================== */
 146          void LCD_DisplayNum4(u8 row, u8 col, u16 num)
 147          {    
 148   1          LCD1602_display_char(row, col,     num / 1000 + '0');
 149   1          LCD1602_display_char(row, col + 1, (num % 1000) / 100 + '0');
 150   1          LCD1602_display_char(row, col + 2, (num % 100) / 10 + '0');
 151   1          LCD1602_display_char(row, col + 3, num % 10 + '0');
 152   1      }
