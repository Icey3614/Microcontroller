 498          /* 选项四：支持两位小数的定点数计算器 */
 499          static void calc_service(void){    
 500   1          u8 d;   
 501   1          if (first_flag) {        
 502   2              first_flag = 0;        
 503   2              LCD1602_clear();        
 504   2              LCD1602_display(1, 1, "Calc Mode: S13=.");       
 505   2              first_num = 0; second_num = 0; oper = 0;        
 506   2              calc_state = CALC_WAIT_FIRST;        
 507   2              has_dot = 0; dot_cnt = 0;   
 508   2          }    
 509   1          if (matrix_key == 0) return;   
 510   1          if (matrix_key == MATRIX_S13) {        
 511   2              if (calc_state == CALC_INPUT_FIRST || calc_state == CALC_INPUT_SECOND) {            
 512   3                  has_dot = 1;           
 513   3                  dot_cnt = 0;            
 514   3                  LCD1602_display_char(2, 15, '.'); // 给予用户视觉反馈       
 515   3              }        
 516   2              return;   
 517   2          }    
 518   1          switch (calc_state)    
 519   1          {        
 520   2              case CALC_WAIT_FIRST:            
 521   2                  if (calc_is_digit(matrix_key)) {                
 522   3                      LCD1602_clear();               
 523   3                      LCD1602_display(1, 1, "Calc Mode: S13=.");                
 524   3                      first_num = calc_get_digit(matrix_key);                
 525   3                      has_dot = 0; dot_cnt = 0;                
 526   3                      LCD_DisplayLong(2, 1, first_num);                
 527   3                      calc_state = CALC_INPUT_FIRST;           
 528   3                  }            
 529   2                  break;        
 530   2              case CALC_INPUT_FIRST:            
 531   2                  if (calc_is_digit(matrix_key)) {                
 532   3                      d = calc_get_digit(matrix_key);               
 533   3                      if (!has_dot) {                    
C51 COMPILER V9.60.7.0   MAIN                                                              06/05/2026 19:47:35 PAGE 10  

 534   4                          first_num = first_num * 10 + d;               
 535   4                      } else if (dot_cnt < 2) {                    
 536   4                          if (dot_cnt == 0) { first_num = first_num * 10 + d; dot_cnt++; }                   
 537   4                          else if (dot_cnt == 1) { first_num = first_num * 10 + d; dot_cnt++; }               
 538   4                      }                
 539   3                      LCD1602_clear();               
 540   3                      LCD1602_display(1, 1, "Calc Mode: S13=.");                
 541   3                      LCD_DisplayLong(2, 1, first_num);                
 542   3                      if (has_dot) LCD1602_display_char(2, 14, 'd');           
 543   3                  }            
 544   2                  else if (matrix_key == MATRIX_S4 || matrix_key == MATRIX_S8 || matrix_key == MATRIX_S12 || mat
             -rix_key == MATRIX_S16) {                
 545   3                      if (!has_dot) {                    
 546   4                          first_num *= 100;               
 547   4                      } else {                    
 548   4                          if (dot_cnt == 1) first_num *= 10;               
 549   4                      }                
 550   3                      if (matrix_key == MATRIX_S4)  oper = '+';               
 551   3                      if (matrix_key == MATRIX_S8)  oper = '-';                
 552   3                      if (matrix_key == MATRIX_S12) oper = '*';               
 553   3                      if (matrix_key == MATRIX_S16) oper = '/';                
 554   3                      LCD1602_display_char(2, 16, oper);                
 555   3                      has_dot = 0; dot_cnt = 0;                
 556   3                      calc_state = CALC_WAIT_SECOND;           
 557   3                  }            
 558   2                  break;        
 559   2              case CALC_WAIT_SECOND:            
 560   2                  if (calc_is_digit(matrix_key)) {                
 561   3                      second_num = calc_get_digit(matrix_key);               
 562   3                      LCD1602_clear(); LCD1602_display(1, 1, "Calc Mode: S13=.");                
 563   3                      LCD_DisplayLong(2, 1, second_num);                
 564   3                      calc_state = CALC_INPUT_SECOND;           
 565   3                  }            
 566   2                  break;        
 567   2              case CALC_INPUT_SECOND:            
 568   2                  if (calc_is_digit(matrix_key)) {                
 569   3                      d = calc_get_digit(matrix_key);               
 570   3                      if (!has_dot) {                    
 571   4                          second_num = second_num * 10 + d;               
 572   4                      } else if (dot_cnt < 2) {                    
 573   4                          if (dot_cnt == 0) { second_num = second_num * 10 + d; dot_cnt++; }                   
 574   4                          else if (dot_cnt == 1) { second_num = second_num * 10 + d; dot_cnt++; }               
 575   4                      }                
 576   3                      LCD1602_clear();               
 577   3                      LCD1602_display(1, 1, "Calc Mode: S13=.");                
 578   3                      LCD_DisplayLong(2, 1, second_num);           
 579   3                  }            
 580   2                  else if (matrix_key == MATRIX_S15) {                
 581   3                      if (!has_dot) {                    
 582   4                          second_num *= 100;               
 583   4                      } else {                    
 584   4                          if (dot_cnt == 1) second_num *= 10;               
 585   4                      }                
 586   3                      LCD1602_clear();                
 587   3                      LCD1602_display(1, 1, "Result:");               
 588   3                      LCD1602_display_char(2, 1, '=');                
 589   3                      if (oper == '+') LCD_DisplayFixedPoint(2, 3, first_num + second_num);               
 590   3                      if (oper == '-') LCD_DisplayFixedPoint(2, 3, first_num - second_num);                
 591   3                      if (oper == '*') LCD_DisplayFixedPoint(2, 3, (first_num * second_num) / 100);             
             -  
 592   3                      if (oper == '/') {                    
 593   4                          if (second_num != 0) {                        
C51 COMPILER V9.60.7.0   MAIN                                                              06/05/2026 19:47:35 PAGE 11  

 594   5                              LCD_DisplayFixedPoint(2, 3, (first_num * 100) / second_num);                   
 595   5                          } else {                        
 596   5                              LCD1602_display(2, 3, "Error Div0");                   
 597   5                          }                
 598   4                      }                
 599   3                      calc_state = CALC_SHOW_RESULT;           
 600   3                  }            
 601   2                  break;        
 602   2              case CALC_SHOW_RESULT:            
 603   2                  if (calc_is_digit(matrix_key)) {                
 604   3                      first_flag = 1;           
 605   3                  }            
 606   2                  break;    
 607   2          } 
 608   1      }
