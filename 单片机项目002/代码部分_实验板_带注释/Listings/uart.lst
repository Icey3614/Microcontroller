  73          /*******************************************************************************
  74          * 函 数 名: UART_ISR
  75          * 函数功能: 串口中断服务函数
  76          *******************************************************************************/
  77          void UART_ISR(void) interrupt 4//串口硬件中断服务函数
  78          {
  79   1          if (RI)//RI（Receive Interrupt flag） 是接收中断标志位
  80   1          {
  81   2              RI = 0;
  82   2              rx_buffer = SBUF;//SBUF 此时充当的是接收缓冲区 。
  83   2              rx_flag = 1;//表明接收到数据
  84   2          }
  85   1      }
