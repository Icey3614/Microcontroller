   8          /*******************************************************************************
   9          * 函 数 名: UART_Init
  10          * 函数功能: 初始化串口，9600bps @11.0592MHz
  11          * 说    明: 使用T1作为波特率发生器，方式2（8位自动重载）
  12          *******************************************************************************/
  13          void UART_Init(void)
  14          {
  15   1      /*
  16   1        这个初始化函数执行完毕后，单片机的串口硬件就进入了完全就绪的待命状态：
  17   1        它时刻盯着自己的引脚，只要电脑用 9600 的波特率发来 8 位的数据，
  18   1        它就会自动把数据收好，并触发串口中断 。
  19   1      */
  20   1          // 串口方式1（8位UART），T1方式2（8位自动重载）
  21   1          SCON = 0x50;                     // 方式1, REN=1允许接收，串口通信寄存器
  22   1          TMOD = (TMOD & 0x0F) | 0x20;    // T1工作在方式2（8位自动重载）
  23   1          TH1 = 0xFD;                      // 9600bps @11.0592MHz
  24   1          TL1 = 0xFD;
  25   1          TR1 = 1;                         // 启动T1
  26   1          ES = 1;                          // 开串口中断
  27   1          EA = 1;                          // 开总中断（若已开则无影响）
  28   1      }
  29          
  30          /*******************************************************************************
  31          * 函 数 名: UART_SendByte
  32          * 函数功能: 发送一个字节
  33          *******************************************************************************/
  34          void UART_SendByte(u8 dat)
  35          {
  36   1          SBUF = dat;//SBUF（Serial Buffer Register） 是串口数据缓冲寄存器。
  37   1      //这是一个非常奇妙的硬件寄存器，它“同名不同质”。当向 SBUF 里写入数据时�
             -�
  38   1      //它指向的是发送缓冲区；当从 SBUF 里读取数据时，它指向的是接收缓冲区。
  39   1          while (!TI);
  40   1      //等待发送完成，数据刚送入时T1 = 0，触发阻塞等待，8位数据发送完成后，TI自�
             -�取反，结束循环
  41   1          TI = 0;//手动设置回到初始状态
  42   1      }
  43          
  44          /*******************************************************************************
  45          * 函 数 名: UART_SendString
  46          * 函数功能: 发送字符串，调用上面的函数，传送字符串
  47          *******************************************************************************/
  48          void UART_SendString(u8 *str)
  49          {
  50   1          while (*str != '\0')
  51   1          {
  52   2              UART_SendByte(*str++);//指针进一位
