  56          /*******************************************************************************
  57          * 函 数 名: UART_ReceiveByte
  58          * 函数功能: 接收一个字节（非阻塞）
  59          * 返 回 值: 接收到的数据，无数据返回0xFF
  60          *******************************************************************************/
  61          u8 UART_ReceiveByte(void)
  62          {
  63   1          u8 dat;
  64   1        if (rx_flag)//判断缓冲区是否有数据
  65   1          {
  66   2            dat = rx_buffer;//接收缓冲区数据
  67   2            rx_flag = 0;//清空缓冲区
  68   2              return dat;//返回接收的数据
  69   2          }
  70   1          return 0xFF;//表明当前缓冲区空闲
  71   1      }
