                    -(.\Listings\key_matrix.lst) TABS(2) OBJECT(.\Objects\key_matrix.obj)

line level    source

   1          #include "key_matrix.h"
   2          // 定义按键状态
   3          #define KEY_IDLE      0  // 空闲态
   4          #define KEY_DEBOUNCE  1  // 按下消抖态
   5          #define KEY_PRESS     2  // 确认压下触发态
   6          #define KEY_RELEASE   3  // 等待完全松手拦截态
   7          
   8          #define KEY_DEBOUNCE_CNT 10    // 软件消抖滤波常数（10ms
   9          /*在标准 51 单片机里，内部 RAM 只有 256 字节。
  10          idata 专门修饰前 256 字节的直接/间接寻址区。
  11          将这几个高频使用的状态机变量放在 idata 里，
  12          单片机在执行流水扫描时，寻址速度最快，能做到真正的“零延迟”响应。*/
  13          //全局静态变量
  14          static u8 idata key_scan_cnt = 0;
  15          static u8 idata key_state = KEY_IDLE;
  16          static u8 idata key_value = 0;       // 对外输出的有效键值
  17          static u8 idata key_temp = 0;        // 硬件扫描中间暂存值 
  18          
  19          /*******************************************************************************
  20          * 函 数 名: key_scan_hardware
  21          * 功能描述: 硬件层快速线反转扫描 4x4 矩阵键盘
  22          * 返 回 值: 按键交叉物理组合码（0x00=无按键压下）
  23          * 引脚映射: 行 P1.7~P1.4，列 P1.3~P1.0 [cite: 802]
  24          *******************************************************************************/
  25          static u8 key_scan_hardware(void)  //确定被按下按键的行与列
  26          {
  27   1          u8 row, col;
  28   1      
  29   1          // 第一步：行引脚输出高电平，列引脚输出低电平，读取行状态
  30   1          P1 = 0xF0; 
  31   1          col = P1 & 0xF0;
  32   1          if (col == 0xF0) return 0x00; // 没有任何键压下，迅速安全返回
  33   1      
  34   1          // 第二步：线反转，列引脚输出高电平，行引脚输出低电平，读取列状态
  35   1          P1 = 0x0F; 
  36   1          row = P1 & 0x0F; 
  37   1      
  38   1          return (col | row); // 按位进行或运算，有1返回1，全0返回0
  39   1      }
  40          
  41          /*******************************************************************************
  42          * 函 数 名: MatrixKey_Tick
  43          * 功能描述: 矩阵按键高灵敏度按下触发状态机（每1ms由定时器T0中断安全分发）
  44          * 两层switch的嵌套，先确定矩阵按键大致的状态，在通过第二层嵌套确定键值
  45          * 最初运行这个函数时，按键（key_state）处于默认状态，
  46          * 在进入第一层switch中时，如果经过对比后发现与默认状态不符，
  47          * 则说明按键状态可能发生了改变，这时将key_state转为可以进入第二种case的状态�
             -��
  48          * 在第二个case中经过一段时间的消抖测试，发现按键的状态确实不是默认了，确�
             -��是改变了，
  49          * 则将key_state转为可以进入第三种case的状态，之后进入第三种case之后，开
  50          * 始具体读取是按下了哪个键，同时将key_state转为可以进入第四种case的状态，
  51          * 第四阶段（松手拦截）：进入第四种 case 之后，单片机会拦截 。
  52          * 只要手指还没抬起来，就一直卡在这个 case 里，
C51 COMPILER V9.60.7.0   KEY_MATRIX                                                        06/03/2026 16:13:01 PAGE 2   

  53          * 不执行任何业务，彻底屏蔽长按连击 。
  54          * 直到下发硬件扫描重新变回默认的 0x00（即手指物理上完全松开）的瞬间，
  55          * 它才会将 key_state 重新赋值为 KEY_IDLE（空闲态），
  56          * 让整个状态机安全返回到最初的默认状态，等待下一次击键 。  
  57          *******************************************************************************/
  58          void MatrixKey_Tick(void)
  59          {
  60   1          u8 key_code;
  61   1      
  62   1          switch (key_state)
  63   1          {
  64   2              case KEY_IDLE:
  65   2                  key_code = key_scan_hardware();
  66   2              /*
  67   2              绝大多数时候，用户没有去按按键，单片机就会每 1ms 进来执行一次 key_scan_har
             -dware()
  68   2              只要返回值是 0x00（无按键），它就什么都不做，直接退出 。
  69   2              跳转条件：一旦某 1ms 进来看见返回值不是 0x00，
  70   2              说明有人碰了键盘 ，它立刻把状态切换到下一种 
  71   2              */
  72   2              if (key_code != 0x00) // 如果发现突然变化了状态
  73   2                  {
  74   3                      key_temp = key_code;    // 临时锁定特征值
  75   3                      key_scan_cnt = 0;       // 清空消抖计数器
  76   3                      key_state = KEY_DEBOUNCE; // 切入消抖过滤判定
  77   3                  }
  78   2                  break;
  79   2      
  80   2              case KEY_DEBOUNCE: 
  81   2                  key_scan_cnt++; 
  82   2              /*
  83   2              消抖态确认，如果消抖过后来的状态还没有改变
  84   2              则确定是发生了按下
  85   2              转入按键确认case
  86   2              */
  87   2                  if (key_scan_cnt >= KEY_DEBOUNCE_CNT) 
  88   2                  {
  89   3                      key_code = key_scan_hardware(); 
  90   3                      if (key_code == key_temp) 
  91   3                          key_state = KEY_PRESS;   // 确认是真实击键，立刻切入压下触发状态
  92   3                      else
  93   3                          key_state = KEY_IDLE;    // 属于噪声抖动，打回原形 
  94   3                  }
  95   2                  break;
  96   2      
  97   2              case KEY_PRESS: 
  98   2                  // 按下瞬间立即译码生成键值，无需等待松手
  99   2                  switch (key_temp) 
 100   2                  {
 101   3                      case 0x77: key_value = MATRIX_S1;  break;
 102   3                      case 0x7B: key_value = MATRIX_S2;  break; 
 103   3                      case 0x7D: key_value = MATRIX_S3;  break; 
 104   3                      case 0x7E: key_value = MATRIX_S4;  break; 
 105   3      
 106   3                      case 0xB7: key_value = MATRIX_S5;  break; 
 107   3                      case 0xBB: key_value = MATRIX_S6;  break; 
 108   3                      case 0xBD: key_value = MATRIX_S7;  break; 
 109   3                      case 0xBE: key_value = MATRIX_S8;  break; 
 110   3      
 111   3                      case 0xD7: key_value = MATRIX_S9;  break; 
 112   3                      case 0xDB: key_value = MATRIX_S10; break; 
 113   3                      case 0xDD: key_value = MATRIX_S11; break;
C51 COMPILER V9.60.7.0   KEY_MATRIX                                                        06/03/2026 16:13:01 PAGE 3   

 114   3                      case 0xDE: key_value = MATRIX_S12; break; 
 115   3      
 116   3                      case 0xE7: key_value = MATRIX_S13; break;
 117   3                      case 0xEB: key_value = MATRIX_S14; break; 
 118   3                      case 0xED: key_value = MATRIX_S15; break; 
 119   3                      case 0xEE: key_value = MATRIX_S16; break; 
 120   3                      default: break; 
 121   3                  }
 122   2                  key_state = KEY_RELEASE; // 键值生成完毕，无缝跳转至松手拦截态阻止连续重
             -发 
 123   2                  break;
 124   2      
 125   2              case KEY_RELEASE: // [cite: 872]
 126   2                //(等待完全松手拦截态) —— 防止连击刷屏
 127   2                  key_code = key_scan_hardware(); // 
 128   2                  if (key_code == 0x00)    // 只有当用户物理上完全松开手指，总线重归空闲时
 129   2                  {
 130   3                      key_state = KEY_IDLE; // 才允许退出拦截状态，准备迎接下一次击键
 131   3                  }
 132   2                  break;
 133   2          }
 134   1      }
 135          
 136          /*******************************************************************************
 137          * 函 数 名: key_get_value
 138          * 功能描述: 读取当前生成的有效矩阵按键值（读取后自动销毁）
 139          *******************************************************************************/
 140          u8 key_get_value(void)
 141          {
 142   1          u8 temp = key_value;
 143   1          if (temp != 0) // 
 144   1              key_value = 0;       // 经典的读清零机制
 145   1          return temp; //
 146   1      }


